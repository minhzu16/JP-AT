# Copy to .env and fill in real values. Do NOT commit .env.
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5433/jobportal?schema=public
REDIS_URL=redis://localhost:6381
# Required, 32+ characters, different from each other: the API refuses to start otherwise.
# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
PORT=4000
WEB_ORIGIN=http://localhost:3000
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=no-reply@jobportal.local
NODE_ENV=development
