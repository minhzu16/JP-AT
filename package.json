{
  "name": "job-portal-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.15.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "db:generate": "pnpm --filter @jobportal/db generate",
    "db:push": "pnpm --filter @jobportal/db push",
    "db:migrate": "pnpm --filter @jobportal/db migrate",
    "db:seed": "pnpm --filter @jobportal/db seed"
  },
  "devDependencies": {
    "turbo": "^2.4.4",
    "typescript": "^5.7.3"
  }
}
